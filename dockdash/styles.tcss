/* ─────────────────────────────────────────────────────────────────
   DockDash — Dynamic High-Contrast Theme System
   Adapts to all color templates: Cyber Slate, Tokyo Night, Dracula,
   Nord, Catppuccin, Monokai, Gruvbox, Synthwave, Solarized Dark.
   ───────────────────────────────────────────────────────────────── */

/* ── Global ────────────────────────────────────────────────────── */

Screen {
    background: $background;
    color: $foreground;
}

/* ── Header & Footer ──────────────────────────────────────────── */

Header {
    background: $surface;
    color: $primary;
    dock: top;
    text-style: bold;
}

Footer {
    background: $surface;
    color: $text-muted;
    dock: bottom;
    height: 1;
}

FooterKey {
    background: $surface;
    color: $primary;
}

FooterKey .footer-key--key {
    background: $panel;
    color: $primary;
    text-style: bold;
}

FooterKey .footer-key--description {
    color: $text;
    background: $surface;
}

FooterKey:hover {
    background: $panel;
}

FooterKey:hover .footer-key--description {
    color: $foreground;
}

FooterLabel {
    color: $text-muted;
    background: $surface;
}

/* ── TabbedContent & Tabs ──────────────────────────────────────── */

TabbedContent {
    background: $background;
}

Tabs {
    background: $surface;
    dock: top;
    height: 3;
    border-bottom: solid $border;
}

Tab {
    background: $surface;
    color: $text-muted;
    padding: 0 2;
    margin: 0 1;
    text-style: bold;
}

Tab:hover {
    background: $panel;
    color: $foreground;
}

Tabs .-active,
Tabs:focus .-active,
Tab.-active,
Tab.-active:hover,
Tabs:focus Tab.-active {
    background: $primary;
    color: $background;
    text-style: bold;
}

Underline {
    color: $primary;
}

.underline--bar {
    background: $primary;
}

TabPane {
    background: $background;
    padding: 1 1;
}

/* ── DataTable ─────────────────────────────────────────────────── */

DataTable {
    background: $background;
    height: 1fr;
    border: solid $border;
    scrollbar-background: $surface;
    scrollbar-color: $border;
    scrollbar-color-active: $primary;
    scrollbar-color-hover: $panel-lighten-1;
}

DataTable > .datatable--header {
    background: $panel;
    color: $primary;
    text-style: bold;
    border-bottom: solid $border;
}

DataTable > .datatable--cursor {
    background: $secondary;
    color: $foreground;
    text-style: bold;
}

DataTable > .datatable--header-cursor {
    background: $panel;
    color: $accent;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: $panel-lighten-1;
}

DataTable:focus > .datatable--cursor {
    background: $primary;
    color: $background;
    text-style: bold;
}

/* ── Status Label Colors ───────────────────────────────────────── */

.status-running {
    color: $success;
    text-style: bold;
}

.status-exited {
    color: $error;
    text-style: bold;
}

.status-paused {
    color: $warning;
    text-style: italic bold;
}

.status-created {
    color: $secondary;
    text-style: bold;
}

.status-restarting {
    color: $warning-lighten-1;
    text-style: bold;
}

.status-removing {
    color: $text-muted;
}

.status-dead {
    color: $error-lighten-1;
    text-style: bold;
}

.status-unknown {
    color: $text-muted;
}

/* ── Panels & Cards ────────────────────────────────────────────── */

.panel {
    background: $surface;
    border: solid $border;
    padding: 1 2;
    margin: 0 0 1 0;
}

.panel-title {
    color: $primary;
    text-style: bold;
    padding: 0 0 1 0;
}

.card {
    background: $panel;
    border: solid $border;
    padding: 1 2;
    margin: 0 1 1 0;
}

/* ── Buttons ───────────────────────────────────────────────────── */

Button {
    background: $panel;
    color: $foreground;
    text-style: bold;
    border: solid $border;
    min-width: 14;
    height: 3;
    padding: 0 2;
    margin: 0 1;
}

Button:hover {
    background: $panel-lighten-1;
    color: $foreground;
    border: solid $primary;
}

Button:focus {
    background: $primary-darken-1;
    color: $foreground;
    text-style: bold;
    border: solid $primary-lighten-1;
}

Button.-primary {
    background: $primary;
    color: $background;
    text-style: bold;
    border: solid $primary-lighten-1;
}

Button.-primary:hover {
    background: $primary-darken-1;
    border: solid $primary-lighten-2;
}

Button.-primary:focus {
    background: $primary-lighten-1;
    color: $background;
    text-style: bold;
    border: solid $foreground;
}

Button.-error {
    background: $error;
    color: $foreground;
    text-style: bold;
    border: solid $error-lighten-1;
}

Button.-error:hover {
    background: $error-lighten-1;
    border: solid $error-lighten-2;
}

Button.-error:focus {
    background: $error-lighten-2;
    color: $background;
    text-style: bold;
    border: solid $foreground;
}

Button.-success {
    background: $success;
    color: $background;
    text-style: bold;
    border: solid $success-lighten-1;
}

Button.-success:hover {
    background: $success-darken-1;
    border: solid $success-lighten-2;
}

Button.-success:focus {
    background: $success-lighten-1;
    color: $background;
    text-style: bold;
    border: solid $foreground;
}

Button.-warning {
    background: $warning;
    color: $background;
    text-style: bold;
    border: solid $warning-lighten-1;
}

Button.-warning:hover {
    background: $warning-darken-1;
    border: solid $warning-lighten-2;
    color: $background;
}

Button.-warning:focus {
    background: $warning-lighten-1;
    color: $background;
    text-style: bold;
    border: solid $foreground;
}

/* ── Form Inputs ───────────────────────────────────────────────── */

Input {
    background: $surface;
    color: $foreground;
    border: solid $border;
    padding: 0 1;
}

Input:focus {
    border: solid $primary;
}

Input.-invalid {
    border: solid $error;
}

Label {
    color: $text;
    padding: 1 0 0 0;
}

Select {
    height: auto;
    border: none;
    background: transparent;
    padding: 0;
}

SelectCurrent {
    background: $surface;
    color: $foreground;
    border: solid $border;
    height: 3;
    padding: 0 1;
}

Select:focus > SelectCurrent,
Select.-expanded > SelectCurrent {
    border: solid $primary;
}

SelectOverlay {
    background: $surface;
    border: solid $primary;
    height: auto;
    max-height: 8;
}

Switch {
    background: $border;
}

Switch.-on {
    background: $primary;
}

/* ── TextArea / Code Editor ────────────────────────────────────── */

TextArea {
    background: $surface;
    color: $foreground;
    border: solid $border;
    height: 1fr;
}

TextArea:focus {
    border: solid $primary;
}

/* ── RichLog ───────────────────────────────────────────────────── */

RichLog {
    background: $background;
    color: $foreground;
    border: solid $border;
    scrollbar-background: $surface;
    scrollbar-color: $border;
    scrollbar-color-active: $primary;
    scrollbar-color-hover: $panel-lighten-1;
    height: 1fr;
    padding: 0 1;
}

/* ── Text Helpers ──────────────────────────────────────────────── */

.text-accent {
    color: $primary;
}

.text-teal {
    color: $accent;
}

.text-muted {
    color: $text-muted;
}

.text-error {
    color: $error;
    text-style: bold;
}

.text-success {
    color: $success;
    text-style: bold;
}

.text-warning {
    color: $warning;
    text-style: bold;
}

.text-bold {
    text-style: bold;
}

/* ── Modal Dialogs ─────────────────────────────────────────────── */

ModalScreen {
    align: center middle;
    background: $background 80%;
}

.modal-dialog {
    background: $surface;
    border: solid $primary;
    padding: 1 2;
    width: 80;
    max-height: 85%;
}

.modal-dialog.-danger {
    border: solid $error;
}

.modal-title {
    background: $panel;
    color: $primary;
    text-style: bold;
    text-align: center;
    padding: 1 0;
    width: 100%;
    border-bottom: solid $border;
    margin-bottom: 1;
}

.modal-dialog.-danger .modal-title {
    color: $error;
    border-bottom: solid $error;
}

.modal-body {
    padding: 1 0;
}

.modal-footer {
    layout: horizontal;
    height: auto;
    min-height: 4;
    align: right middle;
    padding: 1 0 0 0;
    border-top: solid $border;
    margin-top: 1;
}

/* ── Exit Dialog ───────────────────────────────────────────────── */

.exit-dialog {
    width: 44;
    height: auto;
    border: solid $primary;
    padding: 1 2;
}

.exit-buttons {
    layout: vertical;
    width: 100%;
    height: auto;
    align: center middle;
    padding: 1 0 0 0;
}

.exit-buttons Button {
    width: 100%;
    margin: 0 0 1 0;
    height: 3;
}

/* ── Theme Settings Dialog ─────────────────────────────────────── */

.theme-dialog {
    width: 82;
    max-height: 85%;
    border: solid $primary;
}

.theme-body {
    padding: 1 1;
}

.theme-help-text {
    padding: 0 1 1 1;
}

.theme-option-list {
    height: 14;
    background: $surface;
    border: solid $border;
}

.theme-option-list > .option-list--option {
    padding: 0 1;
}

.theme-option-list > .option-list--option-highlighted {
    background: $panel;
    color: $foreground;
    text-style: bold;
}

.theme-footer {
    align: right middle;
    border-top: solid $border;
}

/* ── Connection Error Panel ────────────────────────────────────── */

.error-panel {
    background: $surface;
    border: solid $error;
    padding: 2 4;
    width: 60;
    height: auto;
    align: center middle;
    content-align: center middle;
}

.error-title {
    color: $error;
    text-style: bold;
    text-align: center;
    width: 100%;
}

.error-message {
    color: $foreground;
    text-align: center;
    padding: 1 0;
    width: 100%;
}

/* ── Container Detail Layout ───────────────────────────────────── */

.detail-grid {
    layout: grid;
    grid-size: 2;
    grid-gutter: 1;
    padding: 1;
}

.detail-label {
    color: $text-muted;
    text-style: bold;
    width: auto;
}

.detail-value {
    color: $foreground;
    width: 1fr;
}

/* ── Progress Bar ──────────────────────────────────────────────── */

ProgressBar {
    padding: 0 1;
}

ProgressBar Bar {
    color: $primary;
    background: $border;
}

ProgressBar PercentageStatus {
    color: $text-muted;
    text-style: bold;
}

/* ── Stats Bars ────────────────────────────────────────────────── */

.stat-bar {
    height: 1;
    margin: 0 1;
}

.stat-label {
    color: $primary;
    width: 12;
    text-style: bold;
}

.stat-value {
    color: $foreground;
    width: 1fr;
}

/* ── Scrollbars ────────────────────────────────────────────────── */

* {
    scrollbar-background: $surface;
    scrollbar-color: $border;
    scrollbar-color-hover: $panel-lighten-1;
    scrollbar-color-active: $primary;
    scrollbar-size-vertical: 1;
}

/* ── Search Bar ────────────────────────────────────────────────── */

SearchBar {
    dock: top;
    height: 3;
    background: $surface;
    border: solid $primary;
    padding: 0 1;
    layout: horizontal;
    display: none;
    margin-bottom: 1;
}

SearchBar.-visible {
    display: block;
}

SearchBar .search-icon {
    width: auto;
    height: 1;
    color: $primary;
    text-style: bold;
    margin: 0 1 0 0;
}

SearchBar Input {
    width: 1fr;
    height: 1;
    border: none;
    background: transparent;
    color: $foreground;
    padding: 0;
}

SearchBar Input:focus {
    border: none;
}

/* ── Tab Actions Bar ───────────────────────────────────────────── */

.actions-bar {
    dock: bottom;
    height: 1;
    background: $surface;
    color: $text-muted;
    padding: 0 1;
}

.action-key {
    color: $primary;
    text-style: bold;
}

.action-label {
    color: $text-muted;
}

.error-label {
    color: $error;
    text-style: bold;
    display: none;
    height: auto;
    margin-top: 1;
}
